# =============================================================================
# KIR MEETING AGENT — Variables de entorno
# =============================================================================
# Copiá este archivo como .env.local y completá con valores reales.
#   cp .env.example .env.local
# .env.local NO se commitea (está en .gitignore).
#
# En Vercel: cargar estas variables en Project Settings → Environment Variables.
# En VPS: dejarlas en .env.local en la raíz (Next.js las lee solo en build/run
#   server-side; las que empiezan con NEXT_PUBLIC_ se exponen al browser — acá
#   NO usamos ninguna pública).
#
# IMPORTANTE: sin comillas, sin espacios ni saltos de línea al final del valor.
#   MASTER_KEY=MiClaveExacta            ✅
#   MASTER_KEY="MiClaveExacta"          ❌ (las comillas quedan en el valor)
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATORIAS
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude — análisis de la transcripción y generación de la minuta.
# Obtenela en: https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AssemblyAI — transcripción + diarización (identificación de hablantes).
# Obtenela en: https://www.assemblyai.com/dashboard
# NOTA: el browser la usa para subir el audio directo a AssemblyAI (vía el
# endpoint /api/aai-key). La app es interna; si se necesita ocultarla, sumar
# autenticación delante de la app.
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# OPCIONAL — modelo de Claude
# ─────────────────────────────────────────────────────────────────────────────
# Default: claude-sonnet-4-6 (mejor relación calidad/precio).
# claude-opus-4-7  = más capaz y caro.
# claude-haiku-4-5 = más rápido y barato (reuniones largas).
# CLAUDE_MODEL=claude-sonnet-4-6


# ─────────────────────────────────────────────────────────────────────────────
# RECOMENDADA — Historial compartido (Redis / Vercel KV / Upstash)
# ─────────────────────────────────────────────────────────────────────────────
# Sin esto, el historial de minutas queda solo en localStorage del navegador
# (no se comparte entre usuarios/dispositivos) y el Dashboard solo ve lo local.
# El cliente usa la REST API de Upstash (NO el protocolo Redis TCP 6379).
# Acepta cualquiera de los dos pares de nombres:
KV_REST_API_URL=https://xxxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (alternativa equivalente)
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# RECOMENDADA — Clave maestra de administración
# ─────────────────────────────────────────────────────────────────────────────
# Gatea el borrado de minutas y permite abrir CUALQUIER minuta protegida
# (override admin). Sin esto: el borrado no pide clave y las minutas
# protegidas solo se abren con su clave individual.
# Usar una clave fuerte. Si circuló por chat/handoff, ROTARLA antes de prod.
MASTER_KEY=definir_una_clave_fuerte_aqui


# ─────────────────────────────────────────────────────────────────────────────
# DISTRIBUCIÓN POR EMAIL (Resend) — D.03.04
# ─────────────────────────────────────────────────────────────────────────────
# Habilita el botón "Distribuir": genera el PDF FOG-11 firmado (sello de
# integridad SHA-256) y lo manda adjunto vía Resend. Sin estas variables
# /api/distribute responde 500 con mensaje claro; el resto de la app anda.
#   1. Cuenta en https://resend.com  → API Keys → crear key.
#   2. Domains → agregar kir.com.ar (o un subdominio, ej. mg.kir.com.ar) y
#      cargar los registros DNS que da Resend (SPF + DKIM). DKIM queda
#      resuelto por Resend al verificar el dominio.
#   3. RESEND_FROM debe usar ese dominio verificado.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=KIR Minutas <minuta@kir.com.ar>

# ─────────────────────────────────────────────────────────────────────────────
# SLACK (opcional) — notificación al canal cuando se distribuye
# ─────────────────────────────────────────────────────────────────────────────
# Incoming Webhook de Slack (https://api.slack.com/messaging/webhooks).
# Si está, al distribuir se postea un resumen al canal. Si no, se omite.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# FOLLOW-UP AUTOMÁTICO (D.03.10) — recordatorios de tareas
# ─────────────────────────────────────────────────────────────────────────────
# Protege el endpoint /api/cron/follow-up. En Vercel, si esta env existe,
# Vercel Cron manda Authorization: Bearer $CRON_SECRET automáticamente
# (cron diario configurado en vercel.json). En VPS: cron del sistema con
# ese header. Usar un valor random largo. Requiere RESEND_* y KV.
CRON_SECRET=un_valor_random_largo_aqui
